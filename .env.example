# ==========================================================
# LeetCode Credentials & Cookies
# ==========================================================
# Open LeetCode.com in your browser, log in, open DevTools (F12) -> Application -> Cookies -> https://leetcode.com
LEETCODE_SESSION=your_leetcode_session_here
LEETCODE_CSRF_TOKEN=your_leetcode_csrf_token_here

# ==========================================================
# Gemini AI Configuration
# ==========================================================
# Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ==========================================================
# Groq AI Configuration
# ==========================================================
# Get a Groq API key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ==========================================================
# Solver Preferences & Multi-Problem Configuration
# ==========================================================
# Language choice: 'python3', 'cpp', 'java', 'golang', 'javascript'
PROGRAMMING_LANGUAGE=python3

# Solver Mode: 'potd' (Problem of the Day), 'extra' (solve an extra unsolved problem), 'batch'
SOLVER_MODE=potd

# Difficulty for extra problems: 'EASY', 'MEDIUM', 'HARD', or 'RANDOM'
EXTRA_PROBLEM_DIFFICULTY=RANDOM

# Optional topic tag filter (e.g. 'array', 'dynamic-programming', 'tree')
PROBLEM_TAG=

# ==========================================================
# Resend Email Configuration
# ==========================================================
# Get an API key from https://resend.com/
RESEND_API_KEY=your_resend_api_key_here
TO_EMAIL=your_email@example.com
FROM_EMAIL=LeetCode Bot <onboarding@resend.dev>
